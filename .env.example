# --- Supabase ---
# Project URL and service-role key from your Supabase project settings (Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. Used exclusively in route handlers; never shipped to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini (free tier) ---
# Create a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key
# Optional override. Defaults to gemini-flash-latest if unset (an alias Google
# keeps pointed at their current free-tier flash model — more durable than a
# pinned dated model name, which can be retired off the free tier over time).
GEMINI_MODEL=gemini-flash-latest

# --- Accounts ---
# Any long random string. Used to sign session tokens (JWT) for username/password
# login. Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# --- Password reset email (Resend, free tier) ---
# Create a free key at https://resend.com/api-keys (no card, no domain needed
# to start — the sandbox sender below works immediately).
RESEND_API_KEY=your-resend-api-key
# Optional. Defaults to Resend's shared sandbox sender, which works with zero
# setup. Swap in a verified "Name <you@yourdomain.com>" once you have one.
RESEND_FROM_EMAIL=

# --- Demo mode (off by default) ---
# When "1", restoring a save point uses a bundled canned example instead of
# calling Gemini — so the save/restore experience can still be shown even if
# the live AI key is down or quota'd. Never affects saving, only restoring.
# Leave unset for normal use. Per-visit alternative: add ?demo=1 to the
# /workspace URL instead of setting this build-wide.
NEXT_PUBLIC_DEMO_MODE=
